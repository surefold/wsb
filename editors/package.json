{
  "name": "wsb",
  "displayName": "wsb build files",
  "description": "Syntax highlighting for wsb build files (.ws)",
  "version": "0.1.0",
  "publisher": "watershed",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "wsb",
        "aliases": ["wsb", "wsb"],
        "extensions": [".ws"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wsb",
        "scopeName": "source.wsb",
        "path": "./syntaxes/wsb.tmLanguage.json"
      }
    ]
  }
}
